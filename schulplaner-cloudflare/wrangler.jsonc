{
  // Konfiguration für den Weg über die Konsole:
  //     npx wrangler deploy
  //
  // Damit wird ein Worker mit statischen Dateien veröffentlicht — also genau
  // die Form, die hinter einer …workers.dev-Adresse steckt. `main` ist der
  // Code, `assets` sind die Dateien der Website; der Code erreicht sie über
  // die Bindung ASSETS.
  //
  // Für Cloudflare Pages braucht es diese Datei nicht — dort genügt
  // _worker.js an der Wurzel.
  "name": "schulplaner",
  "main": "_worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  }
}
